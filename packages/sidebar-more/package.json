{
  "name": "dsh-asuta-sidebar-more",
  "version": "0.1.3",
  "engines": {
    "dsh": "0.2.2-rc.2",
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "description": "Simplify DSH sidebar navigation and scroll pinned chats, workspaces and recent conversations together. · 精简 DSH 侧栏入口，让置顶、工作区与最近对话共用滚动区域。",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE*",
    "NOTICE*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuta/dsh-cdx-plus.git",
    "directory": "packages/sidebar-more"
  },
  "homepage": "https://github.com/Asuta/dsh-cdx-plus/tree/main/packages/sidebar-more",
  "bugs": {
    "url": "https://github.com/Asuta/dsh-cdx-plus/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cdx-plus",
    "sidebar",
    "pinned-chats",
    "ui-customization"
  ],
  "license": "MIT"
}
