{
  "name": "dsh-asuta-sidebrowser",
  "version": "0.1.4",
  "type": "module",
  "description": "Browse in the DSH desktop sidebar and let agents operate pages and inspect console, network and styles. · 在 DSH 桌面侧栏中浏览网页，让 Agent 操作页面并检查控制台、网络和样式。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/features.js",
    "src/debug-schema.js",
    "skill",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "plugin-settings.js",
    "settings-ui.js",
    "icon.svg",
    "locale/*.json",
    "LICENSE*",
    "NOTICE*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.2-rc.2 || 0.2.2-rc.3"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check src/features.js",
    "build": "node scripts/build.mjs && npm run build:settings",
    "build:settings": "node scripts/build-settings.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cdx-plus",
    "browser-automation",
    "embedded-browser",
    "developer-tools"
  ],
  "pluginPage": {
    "name": "dsh-asuta-sidebrowser",
    "title": "侧边栏浏览器",
    "route": "/api/plugins/dsh-asuta-sidebrowser/settings",
    "titles": {
      "kasumi-retry": "Kasumi 重试与续写",
      "hiagent-global": "Kasumi 全局适配",
      "hiagent-global-compaction": "全局压缩",
      "hiagent-observability": "性能观测",
      "hiagent-recovery": "恢复保护",
      "hiagent-query-budget": "请求预算",
      "bilibili-account": "B站账号与视频阅读",
      "hiagent-web-search": "网页搜索与读取",
      "seeit-video": "Seeit 视频理解",
      "session-md-export": "导出选项",
      "kasumiflow": "学习事务与课程资料"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuta/dsh-cdx-plus.git",
    "directory": "packages/dsh-sidebrowser"
  },
  "homepage": "https://github.com/Asuta/dsh-cdx-plus/tree/main/packages/dsh-sidebrowser",
  "bugs": {
    "url": "https://github.com/Asuta/dsh-cdx-plus/issues"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "icon": "./icon.svg"
}
