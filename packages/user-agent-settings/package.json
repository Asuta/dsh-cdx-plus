{
  "name": "dsh-asuta-user-agent-settings",
  "version": "0.1.0",
  "peerDependencies": {
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1"
  },
  "type": "module",
  "description": "Edit native global Agent instructions, choose a compression model, and refresh the frontend from Settings.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "core.js",
    "compaction.js",
    "instructions.js",
    "permissions.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE*",
    "NOTICE*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuta/dsh-enhancements.git",
    "directory": "packages/user-agent-settings"
  },
  "homepage": "https://github.com/Asuta/dsh-enhancements/tree/main/packages/user-agent-settings",
  "bugs": {
    "url": "https://github.com/Asuta/dsh-enhancements/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.2-rc.1"
  },
  "license": "MIT",
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    }
  },
  "icon": "./icon.svg"
}
