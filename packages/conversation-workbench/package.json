{
  "name": "dsh-asuta-conversation-workbench",
  "version": "0.1.2",
  "type": "module",
  "description": "Give DSH agents on-demand tools to find and read conversations, manage workspaces, move sessions and inspect PR checks. · 让 DSH Agent 按需查找和读取对话、管理工作区、移动会话并查询 PR 检查结果。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg",
    "LICENSE*",
    "NOTICE*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.2-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuta/dsh-cdx-plus.git",
    "directory": "packages/conversation-workbench"
  },
  "homepage": "https://github.com/Asuta/dsh-cdx-plus/tree/main/packages/conversation-workbench",
  "bugs": {
    "url": "https://github.com/Asuta/dsh-cdx-plus/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cdx-plus",
    "agent-tools",
    "conversation-search",
    "workspace-management"
  ],
  "license": "MIT"
}
