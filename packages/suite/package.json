{
  "name": "dsh-asuta-cdx-plus",
  "version": "0.1.2",
  "type": "module",
  "description": "DSH CDX Plus: familiar interactions, a smoother DSH experience. 18 independently switchable features.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "dsh-asuta-archived-sessions": "0.1.2",
    "dsh-asuta-codex-review": "0.1.2",
    "dsh-asuta-conversation-workbench": "0.1.2",
    "dsh-asuta-desktop-navigation": "0.1.2",
    "dsh-asuta-mermaid-renderer": "0.1.2",
    "dsh-asuta-sidebrowser": "0.1.2",
    "dsh-asuta-git-diff": "0.1.2",
    "dsh-asuta-hide-new-session": "0.1.2",
    "dsh-asuta-history-edit": "0.1.2",
    "dsh-asuta-project-activity": "0.1.2",
    "dsh-asuta-projectless-chat": "0.1.2",
    "dsh-asuta-reasoning-effort-memory": "0.1.2",
    "dsh-asuta-selection-quote": "0.1.2",
    "dsh-asuta-session-mover": "0.1.2",
    "dsh-asuta-sidebar-chat": "0.1.2",
    "dsh-asuta-sidebar-more": "0.1.2",
    "dsh-asuta-user-agent-settings": "0.1.2",
    "dsh-asuta-worktree-control": "0.1.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.2-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuta/dsh-cdx-plus.git",
    "directory": "packages/suite"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ]
}
