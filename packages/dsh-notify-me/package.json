{
  "name": "dsh-asuta-notify-me",
  "version": "0.1.11",
  "description": "Get alerts when DSH needs attention or finishes a background reply, with sounds, native notifications and optional external delivery. · 在需要操作或后台回复结束时通知，支持提示音、原生通知和外部推送。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "macos/DSHNotify.swift",
    "macos/build.sh",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "icon.svg",
    "docs",
    "locale/*.json",
    "LICENSE*",
    "NOTICE*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-web",
    "notification",
    "desktop-notification",
    "notify",
    "notifications",
    "alerts",
    "reminder",
    "reminders",
    "message-alert",
    "needs-your-input",
    "approval-alert",
    "approval-actions",
    "idle-detection",
    "auto-dismiss",
    "background-alert",
    "external-notification",
    "webhook",
    "discord",
    "bark",
    "gotify",
    "feishu",
    "serverchan",
    "wxpusher",
    "push-notification",
    "桌面通知",
    "消息提醒",
    "可操作提醒",
    "审批提醒",
    "提醒插件",
    "需要你操作",
    "回复完成提醒",
    "后台完成提醒",
    "外部通知",
    "推送提醒",
    "提醒",
    "闲置判定",
    "离开判定",
    "cdx-plus",
    "desktop-notifications"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.2-rc.2"
  },
  "author": "chromoany",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-alpha.2": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.2": "compatible",
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || >=0.1.6-alpha.2 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuta/dsh-cdx-plus.git",
    "directory": "packages/dsh-notify-me"
  },
  "homepage": "https://github.com/Asuta/dsh-cdx-plus/tree/main/packages/dsh-notify-me",
  "bugs": {
    "url": "https://github.com/Asuta/dsh-cdx-plus/issues"
  },
  "icon": "./icon.svg"
}
