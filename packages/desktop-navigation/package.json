{
  "name": "dsh-asuta-desktop-navigation",
  "version": "0.1.4",
  "type": "module",
  "description": "Open local file paths from DSH conversations and rename recent chats with a double click. · 从 DSH 对话打开本地文件路径，并通过双击重命名最近对话。",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "navigation-core.js",
    "entry-adapter.js",
    "client.js",
    "client-extension.js",
    "recent-hover.fragment.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/*",
    "README.md",
    "LICENSE*",
    "NOTICE*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuta/dsh-cdx-plus.git",
    "directory": "packages/desktop-navigation"
  },
  "homepage": "https://github.com/Asuta/dsh-cdx-plus/tree/main/packages/desktop-navigation",
  "bugs": {
    "url": "https://github.com/Asuta/dsh-cdx-plus/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cdx-plus",
    "desktop-navigation",
    "file-navigation",
    "conversation-management"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.2-rc.2 || 0.2.2-rc.3"
  },
  "icon": "./icon.svg"
}
