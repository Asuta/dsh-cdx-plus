{
  "name": "dsh-asuta-desktop-navigation",
  "version": "0.1.0",
  "type": "module",
  "description": "Open local Chat paths in File Explorer and animate the Recent section.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "navigation-core.js",
    "entry-adapter.js",
    "client.js",
    "client-extension.js",
    "recent-hover.fragment.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/*",
    "README.md",
    "LICENSE*",
    "NOTICE*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuta/dsh-enhancements.git",
    "directory": "packages/desktop-navigation"
  },
  "homepage": "https://github.com/Asuta/dsh-enhancements/tree/main/packages/desktop-navigation",
  "bugs": {
    "url": "https://github.com/Asuta/dsh-enhancements/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.2-rc.1"
  },
  "icon": "./icon.svg"
}
