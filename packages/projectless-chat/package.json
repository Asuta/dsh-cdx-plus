{
  "name": "dsh-asuta-projectless-chat",
  "version": "0.1.4",
  "type": "module",
  "description": "Start DSH conversations outside a workspace and configure their default working directory. · 新建不绑定工作区的 DSH 对话，并配置默认工作目录。",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "core.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE*",
    "NOTICE*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuta/dsh-cdx-plus.git",
    "directory": "packages/projectless-chat"
  },
  "homepage": "https://github.com/Asuta/dsh-cdx-plus/tree/main/packages/projectless-chat",
  "bugs": {
    "url": "https://github.com/Asuta/dsh-cdx-plus/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cdx-plus",
    "chat",
    "workspace-management"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.2-rc.2 || 0.2.2-rc.3"
  },
  "license": "MIT"
}
