{
  "name": "dsh-asuta-codex-review",
  "version": "0.1.0",
  "type": "module",
  "description": "Codex-style code review in the current DSH conversation",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "locale/*.json",
    "LICENSE*",
    "NOTICE*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuta/dsh-cdx-plus.git",
    "directory": "packages/codex-review"
  },
  "homepage": "https://github.com/Asuta/dsh-cdx-plus/tree/main/packages/codex-review",
  "bugs": {
    "url": "https://github.com/Asuta/dsh-cdx-plus/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "license": "Apache-2.0"
}
